# Supabase — copie para .env.local e preencha com os valores do seu projeto.
# Local (supabase start): use a URL e a anon key impressas pelo CLI.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ID da org de demonstração (Sunny). Use no botão "entrar na org demo".
VITE_DEMO_ORG_ID=11111111-1111-1111-1111-111111111111
