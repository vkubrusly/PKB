# PKB Ops — copie para .env (nunca versionado) e preencha.
# No servidor: valores reais no .env; no ambiente Claude: mesmas chaves em "Variáveis de ambiente".

# Caixa do robô (Gmail; usar senha de app de 16 letras, não a senha normal)
BOT_EMAIL=botpkbhomes@gmail.com
BOT_EMAIL_PASSWORD=

# Buildertrend (usuário dedicado "PKB Ops Bot")
BUILDERTREND_USER=botpkbhomes@gmail.com
BUILDERTREND_PASS=

# Portais de condado — só quando o portal exigir login (Marion: consulta pública, não precisa)
MARION_PORTAL_USER=
MARION_PORTAL_PASS=
CITRUS_PORTAL_USER=
CITRUS_PORTAL_PASS=
ORANGE_PORTAL_USER=
ORANGE_PORTAL_PASS=

# Supabase do projeto PKB (painel → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (para ler comentários de revisão, classificar causas, transcrever áudio de campo)
ANTHROPIC_API_KEY=

# Destinatários
OPS_NOTIFY_EMAIL=realtor@victorkubrusly.com
SOVEREIGN_EMAIL=
