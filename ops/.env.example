# PKB Ops — copy to .env (never committed) and fill in.
# On the server: real values in .env. In the Claude environment: same keys under "Environment variables".

# Bot mailbox (Gmail; use a 16-letter app password, not the account password)
BOT_EMAIL=botpkbhomes@gmail.com
BOT_EMAIL_PASSWORD=

# Buildertrend (dedicated "PKB Ops Bot" user)
BUILDERTREND_USER=botpkbhomes@gmail.com
BUILDERTREND_PASS=

# County portals — only when a portal requires login (Marion: public lookup, not needed)
MARION_PORTAL_USER=
MARION_PORTAL_PASS=
CITRUS_PORTAL_USER=
CITRUS_PORTAL_PASS=
ORANGE_PORTAL_USER=
ORANGE_PORTAL_PASS=

# Supabase project (dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (read review comments, classify causes, transcribe field audio)
ANTHROPIC_API_KEY=

# Recipients
OPS_NOTIFY_EMAIL=realtor@victorkubrusly.com
SOVEREIGN_EMAIL=

# Outbound e-mail: false = every rule writes drafts instead of sending
OPS_SEND_ENABLED=true
OPS_ALWAYS_CC=guilherme@pkbhomes.com

# WhatsApp (Meta WhatsApp Cloud API) — leave empty for dry runs
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=pt_BR
