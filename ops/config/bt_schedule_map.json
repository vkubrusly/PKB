    },
    {
      "item": "^inspection - \\(?tug\\)? ?preliminary power",
      "inspection": "tug|preliminary power|t-pole"
    },
    {
      "item": "^inspection - framing$",
      "inspection": "^framing$|^frame$"
    },
    {
      "item": "^inspection - wall (&|and) vault insulation",
      "inspection": "insulation"
    },
    {
      "item": "^inspection - flatwork pre-?pour",
