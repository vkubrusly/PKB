# Kubrusly Basso — listings. Copy to .env for local runs (never committed).
# In GitHub Actions the same names are secrets/variables (see .github/workflows/kb-listings.yml).

# Database — Supabase project of the "Kubrusly Basso Team" org (Settings → General → Project ID)
KB_SUPABASE_PROJECT_REF=
KB_SUPABASE_ACCESS_TOKEN=            # supabase.com → Account → Access Tokens

# Listing mailboxes (read-only). Gmail/Workspace: IMAP on + app password (16 letters).
LISTING_MAIL1_USER=realtor@victorkubrusly.com
LISTING_MAIL1_PASS=
LISTING_MAIL1_HOST=imap.gmail.com
LISTING_MAIL1_FOLDER=INBOX
LISTING_MAIL2_USER=                  # Gabriel Basso
LISTING_MAIL2_PASS=
LISTING_MAIL2_HOST=imap.gmail.com
LISTING_OWN_DOMAINS=victorkubrusly.com

# Sending (feedback requests, reports). Defaults to mailbox 1.
KB_SEND_ENABLED=false                # 'true' to really send; otherwise drafts only
KB_SMTP_USER=
KB_SMTP_PASS=
KB_SMTP_HOST=smtp.gmail.com
KB_FROM_NAME=Kubrusly Basso Team
KB_ALWAYS_BCC=
KB_AGENT_NAME=Victor Kubrusly
KB_AGENT_PHONE=
KB_ALERT_TO=                         # who hears about a possible offer right away
KB_REPORT_PREVIEW_TO=                # who receives every weekly report first (with the WhatsApp text)

# Report branding
KB_BRAND=Kubrusly Basso Team
KB_BROKERAGE=WRA Business & Real Estate
KB_LOGO_URL=                         # public PNG of the logo (e-mail clients need a URL)

# MLS data — Repliers
REPLIERS_API_KEY=
REPLIERS_AGENTS=                     # our agents as the MLS knows them (name or id), comma-separated
REPLIERS_OFFICE_ID=
REPLIERS_CLASS=residential
KB_MARKET_ZIPS=                      # extra zips to watch besides the listings' own

# Claude (feedback reading + report paragraph). Optional: without it, simple rules are used.
ANTHROPIC_API_KEY=
